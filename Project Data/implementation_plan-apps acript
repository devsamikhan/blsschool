## Proposed Changes

### 1. Google Apps Script (Source Code)
Copy and paste this into your Google Apps Script project:

```javascript
/* GAS Code for BLS School - Double Notification Bridge */
function doPost(e) {
  try {
    var data = JSON.parse(e.postData.contents);
    var type = data.type; // 'admission' or 'inquiry'
    
    // Yahan dono (Principal aur Admin) ke emails likhen
    var recipients = "blendedlearningschoolpk@gmail.com, admin@yourdomain.com"; 
    
    var subject = "Digital Packet: New " + (type === 'admission' ? "Admission" : "Inquiry") + " - " + (data.studentName || data.name);
    var body = "OFFICIAL BLS SCHOOL NOTIFICATION\n";
    body += "----------------------------------------\n\n";
    
    if (type === 'admission') {
      body += "ROLE ACTION: Admission Review Required\n";
      body += "STUDENT: " + data.studentName + "\n";
      body += "FATHER: " + data.fatherName + "\n";
      body += "PHONE: " + data.parentPhone + "\n";
      body += "GRADE: " + data.gradeAppliedFor + "\n";
      body += "TRACKING ID: " + data.id + "\n";
      body += "REMARKS: " + (data.address || "None") + "\n";
    } else {
      body += "ROLE ACTION: Query Response Required\n";
      body += "SENDER: " + data.name + "\n";
      body += "EMAIL: " + data.email + "\n";
      body += "MESSAGE: " + data.message + "\n";
      body += "TRACKING ID: " + data.id + "\n";
    }
    
    body += "\nTIMESTAMP: " + new Date().toLocaleString() + "\n";
    body += "----------------------------------------";

    // 1. Send Email to BOTH simultaneously
    MailApp.sendEmail(recipients, subject, body);
    
    // 2. Mirror to Spreadsheet
    var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
    sheet.appendRow([new Date(), type, (data.studentName || data.name), data.id, "SENT TO BOTH"]);

    return ContentService.createTextOutput(JSON.stringify({"status": "broadcast_complete"}))
      .setMimeType(ContentService.MimeType.JSON);
  } catch (err) {
    return ContentService.createTextOutput(JSON.stringify({"status": "error", "message": err.toString()}))
      .setMimeType(ContentService.MimeType.JSON);
  }
}
```

